<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>030c881e-c1db-4256-b653-21a708cec84d</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>Formula Trace</ProviderName><DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Formula Trace"/><Description DefaultValue="Explore direct inputs and dependents in the active Excel workbook."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/help.html"/>
  <Hosts><Host Name="Workbook"/></Hosts>
  <Requirements><Sets><Set Name="ExcelApi" MinVersion="1.13"/><Set Name="SharedRuntime" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://localhost:3000/index.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Workbook"><Runtimes><Runtime resid="Pane.Url" lifetime="long"/></Runtimes><DesktopFormFactor>
      <FunctionFile resid="Pane.Url"/>
      <ExtensionPoint xsi:type="PrimaryCommandSurface"><OfficeTab id="TabHome"><Group id="Trace.Group">
        <Label resid="Group.Label"/><Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
        <Control xsi:type="Button" id="Trace.Open"><Label resid="Open.Label"/><Supertip><Title resid="Open.Label"/><Description resid="Open.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ShowTaskpane"><TaskpaneId>FormulaTrace</TaskpaneId><SourceLocation resid="Pane.Url"/></Action>
        </Control>
        <Control xsi:type="Button" id="Trace.Map"><Label resid="Map.Label"/><Supertip><Title resid="Map.Label"/><Description resid="Map.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ExecuteFunction"><FunctionName>MapFromRibbon</FunctionName></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://localhost:3000/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://localhost:3000/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://localhost:3000/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Pane.Url" DefaultValue="https://localhost:3000/index.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Formula Trace"/><bt:String id="Open.Label" DefaultValue="Explore Formula"/><bt:String id="Map.Label" DefaultValue="Toggle Formula Map"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Open.Description" DefaultValue="Trace inputs and dependents of a selected cell."/><bt:String id="Map.Description" DefaultValue="Apply or remove the active worksheet formula map (Ctrl+Shift+M)."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
  <ExtendedOverrides Url="https://localhost:3000/shortcuts.json"/>
</OfficeApp>
